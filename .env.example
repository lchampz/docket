# Copie para .env antes de subir: cp .env.example .env

# Banco
POSTGRES_DB=docket
POSTGRES_USER=docket
POSTGRES_PASSWORD=docket
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# Frontend
FRONTEND_PORT=3000
# URL interna do backend na rede do compose. O navegador nunca vê esta URL:
# o Next reescreve /api/* para cá do lado do servidor (ver docs Decisoes D9).
BACKEND_INTERNAL_URL=http://backend:8080
